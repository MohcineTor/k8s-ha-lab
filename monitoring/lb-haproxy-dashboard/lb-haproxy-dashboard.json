{
  "annotations": { "list": [] },
  "description": "Supervision des load balancers HAProxy + Keepalived (VIP, services, historique de failover)",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "VIP Count (split-brain check)",
      "description": "Doit toujours valoir 1. 0 = aucune VIP, 2 ou plus = split-brain.",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(vip_present)", "instant": true, "legendFormat": "VIP" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NO VIP", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "OK", "color": "green", "index": 1 } } },
            { "type": "range", "options": { "from": 2, "to": 100, "result": { "text": "SPLIT-BRAIN", "color": "red", "index": 2 } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "VIP Ownership",
      "description": "Quel serveur détient actuellement la VIP.",
      "gridPos": { "h": 6, "w": 8, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "vip_present", "instant": true, "legendFormat": "{{server}} ({{role}})" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "STANDBY", "color": "blue", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "VIP ACTIVE", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HAProxy Status",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "haproxy_service_up", "instant": true, "legendFormat": "{{server}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Keepalived Status",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "keepalived_service_up", "instant": true, "legendFormat": "{{server}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "VIP Failover History",
      "description": "Historique : quel serveur a eu la VIP et quand elle a basculé.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "vip_present", "legendFormat": "{{server}} ({{role}})" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 80, "lineWidth": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "STANDBY", "color": "blue", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "VIP ACTIVE", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "center",
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Services Health History",
      "description": "Historique de disponibilité de HAProxy et Keepalived sur chaque serveur.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "haproxy_service_up", "legendFormat": "{{server}} - HAProxy" },
        { "refId": "B", "expr": "keepalived_service_up", "legendFormat": "{{server}} - Keepalived" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 80, "lineWidth": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "center",
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Load Balancer Inventory",
      "description": "Vue d'ensemble par serveur : rôle, VIP, HAProxy, Keepalived.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "vip_present", "instant": true, "format": "table" },
        { "refId": "B", "expr": "haproxy_service_up", "instant": true, "format": "table" },
        { "refId": "C", "expr": "keepalived_service_up", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true },
            "indexByName": {
              "server": 0,
              "role": 1,
              "instance": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            },
            "renameByName": {
              "server": "Server",
              "role": "Role",
              "instance": "Instance",
              "Value #A": "VIP",
              "Value #B": "HAProxy",
              "Value #C": "Keepalived"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "center", "cellOptions": { "type": "color-background" } },
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NO", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "YES", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "VIP" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "blue", "value": null },
                    { "color": "green", "value": 1 }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "STANDBY", "color": "blue", "index": 0 } } },
                  { "type": "value", "options": { "1": { "text": "ACTIVE", "color": "green", "index": 1 } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byNames", "options": { "mode": "exclude", "names": ["VIP", "HAProxy", "Keepalived"], "prefix": "All except:", "readOnly": true } },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "auto" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "HAProxy" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
                  { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Keepalived" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
                  { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": { "show": false }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["devops", "haproxy", "keepalived", "load-balancer"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LB Monitoring - HAProxy & Keepalived",
  "uid": "lb-haproxy-keepalived",
  "version": 1
}
